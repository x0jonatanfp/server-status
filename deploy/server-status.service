# Plantilla para systemd: `make install` sustituye los marcadores @...@ por el
# usuario, grupo, home, destino y binario de Node del entorno.
[Unit]
Description=Server Status — estado del servidor en Discord
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=180
StartLimitBurst=15

[Service]
Type=simple
User=@DEPLOY_USER@
Group=@DEPLOY_GROUP@
WorkingDirectory=@DEST@
Environment=HOME=@DEPLOY_HOME@
Environment=LOG_FILE=/var/log/server-status.log
# El lanzador de secretos carga el .env del destino (token y canales). Si no se
# usa, se cambia por la invocacion directa de @NODE_BIN@.
ExecStart=@DEPLOY_HOME@/.secrets/bin/run srv:server-status -- @NODE_BIN@ dist/index.js
Restart=always
RestartSec=15
UMask=0077
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=server-status

# Limites de recursos
LimitNOFILE=65536
MemoryMax=512M

# El bot invoca `sudo -n fail2ban-client`: NoNewPrivileges lo romperia.
# ProtectSystem=full deja /usr, /boot y /etc en solo lectura; /var y ~ siguen
# escribibles.
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
